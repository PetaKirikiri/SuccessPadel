# Copy to .env.local (gitignored); never use a VITE_ prefix for these secrets.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://successpadel.app
CONTROL_HOST=stream-api.example.com
MEDIA_HOST=stream-media.example.com
WHIP_ORIGIN=https://stream-media.example.com
MTX_WEBRTCADDITIONALHOSTS=PUBLIC_VM_IP
MTX_WEBRTCALLOWORIGINS=https://successpadel.app
PUBLISH_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Club owner must choose the audience designation before running.
YOUTUBE_MADE_FOR_KIDS=false
# Coturn with use-auth-secret, or a compatible TURN service. No permanent TURN credentials in the browser.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=
